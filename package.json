{
  "name": "hand-tracking-mvp",
  "productName": "ChemLab 3D",
  "version": "0.1.0",
  "private": true,
  "description": "Offline webcam hand tracking and gesture-controlled 3D chemistry lab",
  "author": "ChemLab 3D contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/logic-check.test.ts && tsx tests/experiment-check.test.ts && tsx tests/static-server.test.ts",
    "electron:start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.chemlab3d.gesturelab",
    "productName": "ChemLab 3D",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
